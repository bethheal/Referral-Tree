{
  "name": "@angelfoods/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.development.local --experimental-strip-types src/server.ts",
    "dev:json": "node --env-file-if-exists=.env --import ./src/scripts/enableJsonDev.ts --experimental-strip-types src/server.ts",
    "dev:postgres": "node --env-file=.env.development.local --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types tests/smsProvider.test.ts && node --experimental-strip-types tests/phoneOtp.test.ts && node --experimental-strip-types tests/membershipAccess.test.ts && node --experimental-strip-types tests/productCatalog.test.ts && node --experimental-strip-types tests/orderService.test.ts && node --experimental-strip-types tests/customerOrderHistory.test.ts && node --experimental-strip-types tests/storefrontModels.test.ts && node --experimental-strip-types tests/backend.test.ts && node --experimental-strip-types tests/config.test.ts && node --experimental-strip-types tests/importAndBootstrapSafety.test.ts && node --experimental-strip-types tests/startupSafety.test.ts",
    "test:postgres:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/runPostgresIntegrationDev.ts",
    "test:orders:postgres:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/runOrderIntegrationDev.ts",
    "db:reconcile:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/reconcileJsonImport.ts",
    "prisma:check:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/checkPrisma.ts",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:check": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env --experimental-strip-types src/scripts/checkNeon.ts",
    "db:check:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/checkNeon.ts",
    "db:inspect:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/inspectPostgresDev.ts",
    "db:check:admin-lock:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/checkInitialAdminLockDev.ts",
    "db:check:super-admin-permissions:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/checkSuperAdminPermissionsDev.ts",
    "db:smoke:admin-lock:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/smokeInitialAdminLockDev.ts",
    "db:import:dry-run": "node --experimental-strip-types src/scripts/importJsonToPostgres.ts",
    "db:import:apply:dev": "node --env-file=.env.development.local --experimental-strip-types src/scripts/importJsonToPostgres.ts --apply",
    "admin:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.development.local --experimental-strip-types src/scripts/createInitialSuperAdmin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
