PORT=3001
API_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
# JSON storage remains local development only until the PostgreSQL runtime migration is complete.
DATABASE_FILE=./data/dev-db.json
# Runtime URL must be Neon pooled; migration URL must be direct and non-production.
DATABASE_URL=
DIRECT_URL=
DATABASE_TARGET=local
NEON_BRANCH=
NEON_ENDPOINT_ID=
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-long-random-secret
MFA_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MIN_CASH_OUT=10
OTP_DEV_MODE=false
MAX_REQUEST_BYTES=32768
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
FLW_SECRET_KEY=
FLW_SECRET_HASH=
PAYMENT_REDIRECT_URL=https://your-api.example.com/api/payments/flutterwave/return
# Membership prices are unconfirmed; zero fails checkout closed until approved.
MEMBERSHIP_SILVER_PRICE_GHS=
MEMBERSHIP_GOLD_PRICE_GHS=
MEMBERSHIP_PREMIUM_PRICE_GHS=
