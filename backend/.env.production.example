# Production server configuration template. Copy to backend/.env.production in
# the deployment secret manager or host configuration; never commit real values.
NODE_ENV=production
PORT=3001
STORAGE_MODE=postgres
DATABASE_TARGET=production

# OWNER ACTION: use the production Neon pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-production-pooler.neon.tech/angelfoods?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-production.neon.tech/angelfoods?sslmode=require
PRODUCTION_NEON_ENDPOINT_ID=ep-production
# Required as a guard against accidentally using the development database.
NEON_ENDPOINT_ID=ep-development

# OWNER ACTION: set the public API and exact browser origins served by this release.
API_BASE_URL=https://api.example.com
ALLOWED_ORIGINS=https://app.example.com

# OWNER ACTION: generate unique secrets in the deployment secret manager.
# JWT_SECRET and OTP_PEPPER must be at least 32 characters, non-default, and high entropy.
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET
OTP_PEPPER=REPLACE_WITH_A_GENERATED_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

OTP_DEV_MODE=false
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MAX_REQUEST_BYTES=32768
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
FREE_TRIAL_DAYS=7
MIN_CASH_OUT=10

# Phase 3 owner/provider action: configure Hubtel credentials before opening registration.
SMS_PROVIDER=hubtel
SMS_LIVE_DELIVERY_ENABLED=false
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_API_BASE_URL=https://smsc.hubtel.com

# Money features remain fail-closed until written owner approval and provider/legal checks.
FEATURE_PAYMENTS_ENABLED=false
FEATURE_COMMISSIONS_ENABLED=false
FEATURE_WITHDRAWALS_ENABLED=false
FLW_SECRET_KEY=
FLW_SECRET_HASH=
PAYMENT_REDIRECT_URL=
MEMBERSHIP_SILVER_PRICE_GHS=
MEMBERSHIP_GOLD_PRICE_GHS=
MEMBERSHIP_PREMIUM_PRICE_GHS=
